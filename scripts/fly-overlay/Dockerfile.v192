# v192 = production v191 image + patch_v192.py + telegramResults.ts (VIP results read from the source groups' messages, esports feed).
# The patch runs here on the files of the production image, so no file has to be fetched from the machine first.
FROM registry.fly.io/oddshunter-worker:deployment-01M63WZCHWVSBBFR8K47EW98ZD AS prod

FROM python:3.12-slim AS patch
WORKDIR /w
COPY --from=prod /app/src/worker/telegram/consensusOutcomeResolver.ts src/worker/telegram/
COPY --from=prod /app/src/worker/providers/flashscore.ts src/worker/providers/
COPY patch_v192.py .
RUN python3 patch_v192.py /w

FROM prod
COPY --from=patch /w/src/worker/telegram/consensusOutcomeResolver.ts /app/src/worker/telegram/
COPY --from=patch /w/src/worker/providers/flashscore.ts /app/src/worker/providers/
COPY src/worker/telegram/telegramResults.ts src/worker/telegram/telegramResults.test.ts /app/src/worker/telegram/
# Any failure below stops the build and leaves production untouched.
RUN cd /app && npx vitest run src/worker/telegram/telegramResults.test.ts src/worker/telegram/consensusOutcomeResolver.test.ts src/worker/providers/flashscore.test.ts
RUN cd /app && npx tsx -e "import('./src/worker/telegram/consensusOutcomeResolver.ts').then(() => console.log('modules ok'))"
RUN cd /app && (npx tsc --noEmit -p . 2>&1 | grep -E "src/worker/(telegram/(consensusOutcomeResolver|telegramResults)|providers/flashscore)" && exit 1 || echo "tsc: nothing on the patched files")
