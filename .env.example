# Copy to .env and fill in the blanks. See the mission report for exactly
# which of these are currently missing and why.

# Postgres connection string (Neon or any standard Postgres works).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real Odds Hunter product prices (not secret — confirmed via Stripe MCP).
STRIPE_PRICE_VIP="price_1U4OMQINKReF4ckumsV9mKQd"
STRIPE_PRICE_BOT="price_1U4OMTINKReF4ckuNNGT0CN0"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

BETFAIR_APP_KEY=""
BETFAIR_USERNAME=""
BETFAIR_PASSWORD=""

# Transactional email for password reset (AgentMail, provisioned via Stripe
# Projects — free tier). AGENTMAIL_INBOX_ID is the sender address created for
# this app (e.g. "noreply-oddshunter@agentmail.to"), not a secret itself.
AGENTMAIL_AGENTMAIL_API_KEY=""
AGENTMAIL_INBOX_ID=""

TELEGRAM_BOT_TOKEN=""

# Public @username of the bot (no "@", no bot token) — used to build the
# t.me deep link for account-linking (see src/worker/telegram/linking.ts).
# Not secret. Chosen name: OddsHunter_SignalsBot (BotFather bot not created
# yet as of 2026-08-18 — TELEGRAM_BOT_TOKEN above is still a placeholder).
TELEGRAM_BOT_USERNAME=""

# Private invite link for the Telegram VIP channel (not the public
# t.me/oddshunter98 one). Shown on /account only to users with an ACTIVE VIP
# entitlement — never hardcode the real value in committed source, only here
# as an empty placeholder.
TELEGRAM_VIP_INVITE_LINK=""

# Real sports data — API-Football / API-Sports (free plan: 100 requests/day,
# 10/minute, no identity verification). PRIMARY pre-match odds source for V1
# as of 2026-08-18 (src/worker/providers/apiFootball.ts,
# createApiFootballOddsProvider) — targets low-scrutiny leagues (India,
# smaller Latin American leagues, see API_FOOTBALL_TARGET_COUNTRIES below)
# rather than major commercial leagues, on Noaim's explicit call: heavily
# watched top leagues are the least likely place for an undetected
# suspicious move. Sign up free at dashboard.api-football.com.
API_FOOTBALL_KEY=""

# Comma-separated country names (must match API-Football's own naming
# exactly — verify via GET /leagues once a real key exists). Default below
# matches Noaim's brief: India (all divisions) + smaller Latin American
# leagues, deliberately excluding EPL/La Liga/Ligue 1/etc.
# API_FOOTBALL_TARGET_COUNTRIES="India,Bolivia,Paraguay,Peru,Ecuador,Venezuela"

# TheOddsAPI (theoddsapi.com) — evaluated 2026-08-18, NOT wired into the
# worker: its free tier only covers NBA/MLB, and even its paid football
# coverage is major commercial leagues only (EPL, La Liga, etc.), which is
# the opposite of what this product wants (see API_FOOTBALL_KEY above). The
# adapter (src/worker/providers/theOddsApi.ts) is kept in case a
# major-league confirmation source becomes useful later, but is not in
# src/worker/index.ts's provider list.
THE_ODDS_API_KEY=""

# --- Worker (src/worker/) — all optional, sensible defaults in src/worker/config.ts ---

# Detection thresholds (spec section 6: no fixed weighting confirmed yet —
# these are starting points, meant to be recalibrated once real signals and
# their outcomes (CLV, false-positive rate) can be measured).
# ODDS_DROP_THRESHOLD_PERCENT="5"
# ODDS_DROP_MIN_PERSISTENCE_SEC="120"
# ODDS_DROP_CORRECTION_REBOUND_PERCENT="2"
# WORKER_POLL_INTERVAL_MS="30000"
# INGEST_POLL_INTERVAL_MS="1200000"  # 20 min — keeps API-Football under its 100 req/day free-tier cap

# Mode observation (spec section 15): must stay "false"/unset until signal
# quality has been validated on real data — never flip to "true" for a
# first real-provider connection.
# SEND_LIVE_ALERTS="false"
