# ---------------------------------------------------------------------------
# OddsHunter — modèle de configuration.
#
# Copier vers `.env` (jamais commité — voir .gitignore) et remplir.
# Ce fichier ne contient QUE des noms de variables et leur usage : aucune
# valeur réelle, aucun secret, aucun token.
#
# Où vivent les vraies valeurs :
#   - Local           : `.env` à la racine (ignoré par Git)
#   - Worker (prod)    : secrets Fly.io  -> `flyctl secrets list` (noms seuls)
#   - Site (prod)      : Environment Variables du projet Vercel "site-web-actuel"
#   - Certaines vars   : gérées par le CLI `stripe projects` (ne pas éditer .projects/ à la main)
#
# Après toute copie depuis `.env` vers une plateforme : retirer les
# guillemets simples autour des valeurs (bug DATABASE_URL déjà rencontré 3x).
# ---------------------------------------------------------------------------

# === Base de données (site + worker) ===================================
# Chaîne de connexion Postgres. Fournisseur courant : Supabase
# (précédemment Neon, puis Prisma Postgres). Le code ne lit QUE DATABASE_URL
# (src/lib/db.ts, prisma.config.ts) — les variables SUPABASE_*/NEON_*/PRISMA_*
# éventuellement présentes dans `.env` local sont des résidus de
# provisioning, non consommées par l'application.
DATABASE_URL=

# === Auth (site) ======================================================
# Secret de signature des sessions NextAuth v5. Générer :
#   openssl rand -base64 32
AUTH_SECRET=
# URL publique canonique du site (https en prod).
AUTH_URL=
NEXT_PUBLIC_APP_URL=

# === Stripe (site) ====================================================
# Compte "Odds.Hunter98", projet Stripe "oddscope".
# ATTENTION : le site tourne en mode TEST (clé sk_test_...). Ne jamais
# passer en live sans demande explicite de Noaim (traite de l'argent réel).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de prix (non secrets mais spécifiques test/live — un ID live utilisé
# en mode test échoue silencieusement). Les récupérer dans le Dashboard Stripe.
STRIPE_PRICE_VIP=
STRIPE_PRICE_BOT=

# === E-mail transactionnel (site — reset mot de passe) ================
# AgentMail (provisionné via Stripe Projects). Historiquement suspendu
# (conformité AWS) -> le flux "mot de passe oublié" peut être cassé.
# AGENTMAIL_INBOX_ID = adresse expéditrice créée pour l'app, pas un secret.
AGENTMAIL_AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# === Telegram — Bot API (grammy, site + worker) =======================
# Token du bot @... créé via @BotFather.
TELEGRAM_BOT_TOKEN=
# @username public du bot (sans "@", sans token) — sert à construire le
# deep link t.me de liaison de compte (src/worker/telegram/linking.ts).
TELEGRAM_BOT_USERNAME=
# Lien d'invitation privé du canal VIP (PAS le lien public t.me/oddshunter98).
# Affiché sur /account aux abonnés VIP actifs uniquement.
TELEGRAM_VIP_INVITE_LINK=

# === Telegram — MTProto / compte perso (worker : pipeline consensus) ==
# Identifiants d'application obtenus sur https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session string du compte Telegram personnel qui est MEMBRE des groupes
# de pronostics. Générée UNE fois par un login manuel (StringSession gramjs).
# Secret le plus sensible du projet : équivaut à un accès complet au compte.
# Ne jamais logger, ne jamais commiter, stocker en secret Fly uniquement.
TELEGRAM_USER_SESSION=

# === LLM fallback de parsing des pronostics (worker) ==================
# Utilisé quand le parseur déterministe + OCR échoue à extraire le pick
# (src/worker/telegram/tipLlmFallback.ts). Désactivable via
# TIP_LLM_FALLBACK_ENABLED=false.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
TIP_LLM_FALLBACK_ENABLED=
TIP_LLM_FALLBACK_MODEL=

# === Sources de cotes (worker) =======================================
# BetExplorer est la seule source réellement active (gratuite, sans clé) —
# activée par défaut, désactivable via BETEXPLORER_ENABLED=false.
# API-Football : clé présente mais endpoint /odds bloqué en gratuit ; le
# provider n'est plus branché dans l'ingestion (voir src/worker/index.ts).
API_FOOTBALL_KEY=
# The Odds API : adaptateur présent mais non branché (couvre les grands
# championnats, hors cible produit).
THE_ODDS_API_KEY=
# Betfair Exchange : bloqué réglementairement en France — laisser vide.
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# === Interrupteurs d'envoi (worker) — TOUS "false" par défaut =========
# Mode observation : le worker détecte/stocke mais n'envoie rien tant que
# le flag n'est pas explicitement "true". Ne jamais activer sans validation
# de la qualité sur données réelles.
SEND_LIVE_ALERTS=
SEND_LEGACY_DETECTOR_ALERTS=
SEND_SUSPICIOUS_ALERTS=
SEND_TIP_CONSENSUS_ALERTS=
SUSPICIOUS_FILTER_EXPLAINED_MOVES=

# === Routage optionnel vers des canaux Telegram (worker) =============
# Si défini, le feed "suspicious" est AUSSI posté dans ces canaux.
TELEGRAM_SUSPICIOUS_ALERTS_CHAT_ID=
TELEGRAM_SUSPICIOUS_CLOSURES_CHAT_ID=
TELEGRAM_SUSPICIOUS_REPLAYS_CHAT_ID=

# === Réglages fins (worker) — tous optionnels, défauts dans src/worker/config.ts
# Consensus pronostics :
TIP_CONSENSUS_MIN_GROUPS=            # défaut 3 (canaux distincts)
TIP_CONSENSUS_WINDOW_MINUTES=        # défaut 1440 (24 h)
TIP_MAX_MESSAGE_AGE_MINUTES=         # défaut 30 (rejet du backlog après reconnexion)
CHAT_FIXTURE_CONTEXT_WINDOW_MINUTES= # défaut 60
# Détection de mouvements de cotes :
MIN_SCORE_TO_ALERT=                  # défaut 35
SUSPICIOUS_MIN_SCORE=               # défaut 55
FIXING_ODDS_MIN=                     # défaut 1.2
FIXING_ODDS_MAX=                     # défaut 3.0
ODDS_DROP_THRESHOLD_PERCENT=
ODDS_RISE_THRESHOLD_PERCENT=
VIG_EXPLOSION_MIN_INCREASE_PP=
MULTI_BOOK_MIN_CONFIRMING_BOOKMAKERS=
VALUE_BET_MIN_EDGE_PERCENT=
VALUE_BET_REFERENCE_BOOKMAKER=
# BetExplorer (politesse du scraping) :
BETEXPLORER_MAX_DETAIL_FETCHES_PER_CYCLE=  # défaut 8
BETEXPLORER_MIN_REQUEST_INTERVAL_MS=       # défaut 1500
BETEXPLORER_MIN_DROP_PERCENT_FOR_DETAIL=
# Cadences de boucle :
WORKER_POLL_INTERVAL_MS=             # défaut 180000 (3 min)
INGEST_POLL_INTERVAL_MS=            # défaut 900000 (15 min)
STRATEGY_POLL_INTERVAL_MS=          # défaut 300000 (5 min)
# Ciblage des ligues :
API_FOOTBALL_TARGET_COUNTRIES=       # défaut "India,Bolivia,Paraguay,Peru,Ecuador,Venezuela"
API_FOOTBALL_EXCLUDED_LEAGUES=       # défaut "Indian Super League"
MOMENTUM_TARGET_LEAGUE_IDS=          # défaut "39,140,61,135,78,88,94,2,3"

# === Divers ==========================================================
NODE_ENV=
