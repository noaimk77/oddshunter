# Copy to .env and fill in the blanks. See the mission report for exactly
# which of these are currently missing and why.

# Postgres connection string (Neon or any standard Postgres works).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real Odds Hunter product prices (not secret — confirmed via Stripe MCP).
STRIPE_PRICE_VIP="price_1U4OMQINKReF4ckumsV9mKQd"
STRIPE_PRICE_BOT="price_1U4OMTINKReF4ckuNNGT0CN0"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

BETFAIR_APP_KEY=""
BETFAIR_USERNAME=""
BETFAIR_PASSWORD=""

# Transactional email for password reset (AgentMail, provisioned via Stripe
# Projects — free tier). AGENTMAIL_INBOX_ID is the sender address created for
# this app (e.g. "noreply-oddshunter@agentmail.to"), not a secret itself.
AGENTMAIL_AGENTMAIL_API_KEY=""
AGENTMAIL_INBOX_ID=""

# VIP channel access is automatic: each VIP subscriber gets a personal
# join-request link on /account, the bot approves it only while their VIP
# subscription is ACTIVE, and removes them from the channel when it ends.
# The bot must be an admin of the channel with "Invite users via link" and
# "Ban users". After filling these in, run `npm run telegram:setup`.
TELEGRAM_BOT_TOKEN=""
# Numeric id of the private VIP channel, e.g. "-1001234567890".
TELEGRAM_VIP_CHAT_ID=""
# Random string Telegram echoes on each webhook call — generate with:
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# Real sports data — API-Football / API-Sports (free plan: 100 requests/day,
# 10/minute). Set in .env.local, NOT here and NOT in .env — Next.js loads
# .env.local automatically and it is gitignored (see .gitignore).
API_FOOTBALL_KEY=""
